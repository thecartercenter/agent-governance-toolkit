  "sandbox": {
    "allowUnsandboxedCommands": false,
    "enabled": true,
     "filesystem": {
    "allowRead": [
      "/private/etc/ssl/cert.pem",
      "/etc/ssl/cert.pem",
      "/opt/homebrew/etc/ca-certificates/cert.pem"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
