{
  "companyAnnouncements": [
    "Claude Code now has safety guardrails. Some risky actions are blocked or need your approval. Questions: <shared IT mailbox>."
  ],
  "permissions": {
    "deny": [
      "Bash(sudo:*)", "PowerShell(sudo:*)",
      "Bash(rm -r:*)", "Bash(rm -fr:*)", "Bash(rm -R:*)", "Bash(rm --recursive:*)",
      "PowerShell(Remove-Item -Recurse:*)", "PowerShell(rm -r:*)", "PowerShell(rmdir:*)", "PowerShell(rd:*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)", "Bash(git clean -f:*)",
      "PowerShell(git push --force:*)", "PowerShell(git push -f:*)", "PowerShell(git reset --hard:*)", "PowerShell(git clean -f:*)",
      "PowerShell(iex:*)", "PowerShell(Invoke-Expression:*)",
      "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.azure/**)", "Read(~/.config/gcloud/**)", "Read(~/.kube/**)",
      "Read(~/.docker/config.json)", "Read(~/.git-credentials)", "Read(~/.npmrc)",
      "Read(**/.env)", "Read(**/.env.*)", "Read(**/*.pem)", "Read(**/*.key)", "Read(**/*.pfx)",
      "Edit(~/.claude/**)", "Edit(**/.claude/settings.json)", "Edit(**/.claude/settings.local.json)"
    ],
    "ask": [
      "Bash(npm install:*)", "Bash(npm i:*)", "Bash(npx:*)", "Bash(pip install:*)",
      "PowerShell(npm install:*)", "PowerShell(npm i:*)", "PowerShell(npx:*)", "PowerShell(pip install:*)",
      "PowerShell(winget install:*)", "PowerShell(Install-Module:*)",
      "Bash(rm:*)", "PowerShell(Remove-Item:*)",
      "Bash(curl:*)", "Bash(wget:*)", "PowerShell(Invoke-WebRequest:*)", "PowerShell(iwr:*)", "PowerShell(curl:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  }
}
